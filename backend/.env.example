# auto: use Qwen when a key exists, otherwise use deterministic local rules.
TINGJIAN_AI_MODE=auto
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PARSE_MODEL=qwen-flash
QWEN_REPORT_MODEL=qwen-plus
TINGJIAN_REQUEST_TIMEOUT_SECONDS=20
TINGJIAN_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

